{
  "name": "n8n-judge",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @judge/web",
    "build": "npm run build --workspace @judge/web",
    "start": "npm run start --workspace @judge/web",
    "test": "vitest run",
    "smoke": "node apps/web/scripts/smoke.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "playwright-core": "^1.61.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
