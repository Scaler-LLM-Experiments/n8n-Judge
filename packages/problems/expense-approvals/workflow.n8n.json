{
  "name": "Expense Claim Approvals",
  "nodes": [
    {
      "id": "trigger-1",
      "name": "New Email",
      "type": "n8n-nodes-base.gmailTrigger",
      "typeVersion": 1.4,
      "position": [
        0,
        180
      ],
      "parameters": {
        "pollTimes": {
          "item": [
            {
              "mode": "everyMinute"
            }
          ]
        },
        "simple": false,
        "filters": {}
      },
      "credentials": {
        "gmailOAuth2": {
          "id": null,
          "name": "Gmail account"
        }
      }
    },
    {
      "id": "classify-1",
      "name": "Classify with AI",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.7,
      "position": [
        260,
        180
      ],
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.body }}",
        "messages": {
          "messageValues": [
            {
              "message": "Classify the email. Reply with JSON: {\"category\",\"urgency\"}.\nReply with JSON only. The category must be exactly one of: auto_approve, manager_approval, missing_info."
            }
          ]
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "model-1",
      "name": "Gemini Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1,
      "position": [
        275,
        340
      ],
      "parameters": {
        "modelName": "models/gemini-2.5-flash",
        "options": {
          "temperature": 0
        }
      },
      "credentials": {
        "googlePalmApi": {
          "id": null,
          "name": "Google Gemini account"
        }
      }
    },
    {
      "id": "parse-1",
      "name": "Parse Result",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [
        540,
        180
      ],
      "parameters": {
        "mode": "manual",
        "includeOtherFields": true,
        "assignments": {
          "assignments": [
            {
              "id": "assign-0",
              "name": "decision",
              "value": "={{ $json.text.decision }}",
              "type": "string"
            },
            {
              "id": "assign-1",
              "name": "amount",
              "value": "={{ $json.text.amount }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "switch-1",
      "name": "Switch",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.4,
      "position": [
        800,
        180
      ],
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict",
                  "version": 2
                },
                "conditions": [
                  {
                    "id": "cond-0",
                    "leftValue": "={{ $json.category }}",
                    "rightValue": "auto_approve",
                    "operator": {
                      "type": "string",
                      "operation": "equals",
                      "name": "filter.operator.equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "Auto Approve"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict",
                  "version": 2
                },
                "conditions": [
                  {
                    "id": "cond-1",
                    "leftValue": "={{ $json.category }}",
                    "rightValue": "manager_approval",
                    "operator": {
                      "type": "string",
                      "operation": "equals",
                      "name": "filter.operator.equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "Manager Approval"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict",
                  "version": 2
                },
                "conditions": [
                  {
                    "id": "cond-2",
                    "leftValue": "={{ $json.category }}",
                    "rightValue": "missing_info",
                    "operator": {
                      "type": "string",
                      "operation": "equals",
                      "name": "filter.operator.equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "Missing Info"
            }
          ]
        },
        "options": {
          "fallbackOutput": "extra"
        }
      }
    },
    {
      "id": "action-approve",
      "name": "Send Reply — Approved",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        1080,
        40
      ],
      "parameters": {
        "resource": "message",
        "operation": "send",
        "sendTo": "={{ $('New Email').item.json['from'] }}",
        "subject": "Re: your request",
        "message": "Thanks for reaching out — we’re on it.",
