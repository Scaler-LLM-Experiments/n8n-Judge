# n8n Judge — environment template. Copy to .env (git-ignored) and fill in.

# --- Database (Prisma + pg-boss share this Postgres) -----------------------
# Host port for the docker-compose Postgres. Change it if 5432 is already
# taken on your machine (a native Postgres, or another project's container),
# and keep DATABASE_URL's port in sync.
POSTGRES_PORT="5432"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/judge?schema=public"

# --- Auth (interim email/password before Login-with-Scaler SSO) ------------
AUTH_SECRET="change-me-openssl-rand-base64-32"
# Behind a proxy (Railway, any load balancer) Auth.js must be told to trust the
# forwarded host, or it builds callback URLs from the container's internal
# hostname and login redirects land on localhost. Not needed for local dev.
AUTH_TRUST_HOST="true"
# Only needed if the deployed origin can't be inferred; harmless to set.
# AUTH_URL="https://your-app.up.railway.app"

# --- Claude API ------------------------------------------------------------
ANTHROPIC_API_KEY=""
# Model tiers (swappable). Sonnet for grading and authoring; cheap tier for Ask-AI.
JUDGE_GRADING_MODEL="claude-sonnet-5"
JUDGE_AUTHORING_MODEL="claude-sonnet-5"
JUDGE_ASKAI_MODEL="claude-haiku-4-5-20251001"

# --- Queue -----------------------------------------------------------------
# pg-boss now, sqs later. pg-boss reuses DATABASE_URL.
QUEUE_DRIVER="pgboss"
GRADING_CONCURRENCY="10"

# --- Voice / mascot --------------------------------------------------------
# Iris speaks through a text-to-speech vendor. Nothing here is read while a
# learner is using the app: clips are rendered on a laptop, uploaded once, and
# served as files. With no clips, narration degrades to on-screen captions and the
# mascot still reacts, so a missing key is a normal state, not a broken screen.
#
# Which vendor renders. Both are supported and their clips have different file
# names, so the two libraries coexist and switching back is a config change.
#
#   elevenlabs  (default) v3 understands the [warm]/[calm] delivery tags in the
#               phrase book and acts on them. Emotion comes from the tag.
#   deepgram    an Aura model IS the voice, so there is no separate voice id.
#               Tags are stripped before sending, because it reads them aloud.
VOICE_VENDOR="elevenlabs"

# Needed only to RENDER (`npm run voice:generate`). The deployed app never calls a
# vendor and does not need any of these.
ELEVENLABS_API_KEY=""
# With ElevenLabs the voice is separate from the model. Find the id in Voices, on
# the voice's card (or three dots, Copy Voice ID). It is part of every clip
# fingerprint, so changing it re-renders the whole library. A deliberate act.
ELEVENLABS_VOICE_ID=""
# v3 is the model that understands the inline [tags].
ELEVENLABS_MODEL_ID="eleven_v3"

# Only when VOICE_VENDOR=deepgram. An Aura model names the speaker.
DEEPGRAM_API_KEY=""
DEEPGRAM_TTS_MODEL="aura-2-helena-en"

# --- Where clips live ------------------------------------------------------
# The workflow is: render locally -> `npm run voice:sync` uploads -> the app
# reads. The app fetches each clip from the bucket AT MOST ONCE and then serves
# it from its own disk, so traffic is bounded by clips played, not by learners.
#
# Nothing here polls the bucket. Working out what needs rendering or uploading
# is answered from local disk and a local ledger, never by asking S3 — asking
# per object is what got a set of credentials flagged.
AUDIO_S3_BUCKET=""
AUDIO_S3_REGION="ap-south-1"
AUDIO_S3_ACCESS_KEY_ID=""
AUDIO_S3_SECRET_ACCESS_KEY=""
# Optional, so clips can share a bucket without colliding.
AUDIO_S3_PREFIX="voice-clips"
# Only for S3-compatible stores that are not AWS (Cloudflare R2, Backblaze B2,
# MinIO). Leave empty for real S3.
AUDIO_S3_ENDPOINT=""

# Where rendered clips are written on your machine before upload (git-ignored).
VOICE_CLIP_DIR=".voice-clips"
# Where the running app keeps its one copy of each clip it has served. Ephemeral
# and safe to delete: it refills on demand, and a clip's name contains a hash of
# its own audio, so a cached file can never be stale.
VOICE_CACHE_DIR=".voice-cache"
